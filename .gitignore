# Variáveis de ambiente e credenciais
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.crt
secrets/
credentials/

# Ambientes virtuais e cache do Python
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Cobertura e ferramentas de desenvolvimento
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pyright/

# Banco de dados local e arquivos SQLite
*.db
*.sqlite
*.sqlite3

# Documentos gerados, uploads e arquivos temporários
storage/documents/*
storage/temporary/*
storage/uploads/*
!storage/documents/.gitkeep
!storage/temporary/.gitkeep
!storage/uploads/.gitkeep
*.pdf
*.tmp
*.temp

# Logs
*.log
logs/

# Configurações de IDE e sistema operacional
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Builds e distribuição
build/
dist/
*.egg-info/
.eggs/

# Ferramentas locais
.envrc
.direnv/

app/data/generated/*
!app/data/generated/.gitkeep
app/data/inbox/*
!app/data/inbox/.gitkeep
